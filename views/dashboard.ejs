<%
  const st = active.station;
  const r  = active.reading;

  const STATUS = {
    nominal:  { label: 'NOMINAL',  cls: 'nominal'  },
    degraded: { label: 'DEGRADED', cls: 'degraded' },
    critical: { label: 'CRITICAL', cls: 'critical' },
  };
  const meta = STATUS[active.status];

  const criticals = active.alerts.filter(a => a.severity === 'critical');
  const warnings  = active.alerts.filter(a => a.severity === 'warning');

  const coord = (value, pos, neg) => Math.abs(value).toFixed(4) + '° ' + (value >= 0 ? pos : neg);

  const PILLARS = {
    environment:    'Environment',
    energy:         'Energy',
    infrastructure: 'Infrastructure',
    logistics:      'Logistics',
  };

  // Sparkline series come from history; an empty history must not print Infinity.
  const lo = (a) => (a && a.length ? Math.min.apply(null, a) : 0);
  const hi = (a) => (a && a.length ? Math.max.apply(null, a) : 0);

  // One accent, three states. Severity is the only thing that earns a colour.
  const tone = (level) => (level === 2 ? 'crit' : level === 1 ? 'warn' : '');
%>

<header style="border-bottom:1px solid var(--hair-soft)">
  <div class="mx-auto flex max-w-[1560px] flex-wrap items-center gap-x-6 gap-y-3 px-5 py-4 sm:px-8">
    <div>
      <p style="font-size:12.5px;font-weight:800;letter-spacing:-.02em">Antarctic Digital Twin</p>
      <p class="eyebrow" style="margin-top:2px">Maitri &amp; Bharati &middot; MoES / NCPOR &middot; PS 26060</p>
    </div>

    <nav class="seg" aria-label="Station selection">
      <% snapshots.forEach(function (snap) { %>
        <a href="/?station=<%= snap.station.code %>"<%= snap.station.code === st.code ? ' aria-current="page"' : '' %>>
          <span class="sdot <%= STATUS[snap.status].cls %>" aria-hidden="true"></span><%= snap.station.name %>
        </a>
      <% }); %>
    </nav>

    <nav class="seg" aria-label="View selection">
      <a href="/?station=<%= st.code %>" aria-current="page">Console</a>
      <%# Only Bharati has a traced architectural set, so say so when you are not on it. %>
      <a href="/twin">3D Twin<%= st.code === 'BHARATI' ? '' : ' \u00b7 Bharati' %></a>
    </nav>

    <div class="ml-auto flex items-baseline gap-5">
      <span class="eyebrow">Live feed</span>
      <span class="mono" id="utc-clock" style="font-size:12px;font-weight:700">--:--:-- UTC</span>
    </div>
  </div>
</header>

<main class="mx-auto max-w-[1560px] px-5 py-7 sm:px-8">
  <div class="grid gap-5 xl:grid-cols-[336px_minmax(0,1fr)] xl:items-start">

    <!-- ── Left rail: who this is, and what is wrong ───────────────────────── -->
    <div class="stg grid gap-5 xl:sticky xl:top-6">

      <section class="bez raised">
        <div class="core" style="gap:0;padding:20px 22px">
          <p class="eyebrow">Station</p>
          <h2 class="station-h" style="margin-top:7px"><%= st.name %></h2>
          <p class="sub" style="margin-top:5px"><%= st.region %></p>
          <p class="mono" style="margin-top:9px;font-size:10px;color:var(--ink4);line-height:1.7">
            <%= coord(st.coordinates.latitude, 'N', 'S') %> &nbsp; <%= coord(st.coordinates.longitude, 'E', 'W') %><br>
            <%= st.code %> &middot; commissioned <%= st.commissionedYear %>
          </p>

          <div style="margin-top:16px"><span class="pill <%= meta.cls %>"><span class="dot" aria-hidden="true"></span><%= meta.label %></span></div>

          <div style="margin-top:16px;border-top:1px solid var(--hair-soft);padding-top:4px">
            <div class="mrow">
              <span class="ml">Crew on station</span>
              <span class="mv"><span data-metric="logistics.crewOnStation" data-dp="0"><%= r ? helpers.int(r.logistics.crewOnStation) : '--' %></span><span class="mu">/ <%= st.crewCapacity %></span></span>
            </div>
            <div class="mrow">
              <span class="ml">Last contact</span>
              <span class="mv" id="last-contact" style="font-size:10.5px;font-weight:400;color:var(--ink3)"><%= helpers.stamp(active.recordedAt) %></span>
            </div>
          </div>
        </div>
      </section>

      <section aria-live="polite" aria-label="Active alerts" class="grid gap-4">
        <% if (active.alerts.length === 0) { %>
          <div class="bez tint"><div class="core" style="padding:16px 18px;gap:6px">
            <p class="eyebrow on">All clear</p>
            <p class="sub">All four pillars are inside their operating envelope. No active alerts.</p>
          </div></div>
        <% } %>

        <% if (criticals.length) { %>
          <div class="bez alarm"><div class="core" style="padding:14px 16px;gap:2px">
            <p class="eyebrow" style="color:var(--crit);margin-bottom:6px">
              <%= criticals.length %> critical <%= criticals.length === 1 ? 'alert' : 'alerts' %>
            </p>
            <% criticals.forEach(function (a) { %>
              <div class="alert c">
                <span class="tag"><%= PILLARS[a.pillar] %></span>
                <span class="msg"><%= a.message %></span>
              </div>
            <% }); %>
          </div></div>
        <% } %>

        <% if (warnings.length) { %>
          <div class="bez caution"><div class="core" style="padding:14px 16px;gap:2px">
            <p class="eyebrow" style="color:var(--warn);margin-bottom:6px">
              <%= warnings.length %> <%= warnings.length === 1 ? 'warning' : 'warnings' %>
            </p>
            <% warnings.forEach(function (a) { %>
              <div class="alert w">
                <span class="tag"><%= PILLARS[a.pillar] %></span>
                <span class="msg"><%= a.message %></span>
              </div>
            <% }); %>
          </div></div>
        <% } %>
      </section>
    </div>

    <!-- ── Right: the four pillars ─────────────────────────────────────────── -->
    <% if (!r) { %>
      <div class="bez"><div class="core" style="padding:26px"><p class="sub">No telemetry recorded for this station yet.</p></div></div>
    <% } else { %>
    <div class="stg grid gap-5">

      <div class="grid gap-5 md:grid-cols-2">

        <!-- ENVIRONMENT -->
        <section class="bez"><div class="core">
          <div class="flex items-center justify-between" style="margin-bottom:9px">
            <h3 class="pillar-h">Environment</h3>
            <% if (r.environment.blizzard) { %>
              <span class="mono" style="font-size:9px;letter-spacing:.12em;color:var(--crit);background:rgba(168,48,28,.12);padding:2.5px 7px;border-radius:5px">BLIZZARD</span>
            <% } else { %>
              <span class="eyebrow">Outdoor envelope</span>
            <% } %>
          </div>
          <%- include('partials/metric', { label: 'Air temperature', value: helpers.num(r.environment.temperatureC), unit: '°C', metric: 'environment.temperatureC', dp: 1 }) %>
          <%- include('partials/metric', { label: 'Wind chill', value: helpers.num(r.environment.windChillC), unit: '°C', metric: 'environment.windChillC', dp: 1, tone: tone(r.environment.windChillC <= -45 ? 2 : 0) }) %>
          <%- include('partials/metric', { label: 'Wind sustained', value: helpers.num(r.environment.windSpeedKts), unit: 'kts', metric: 'environment.windSpeedKts', dp: 1, tone: tone(r.environment.windSpeedKts >= 45 ? 2 : (r.environment.windSpeedKts >= 34 ? 1 : 0)) }) %>
          <%- include('partials/metric', { label: 'Peak gust', value: helpers.num(r.environment.windGustKts), unit: 'kts', metric: 'environment.windGustKts', dp: 1 }) %>
          <%- include('partials/metric', { label: 'Visibility', value: helpers.int(r.environment.visibilityM), unit: 'm', metric: 'environment.visibilityM', dp: 0, tone: tone(r.environment.visibilityM < 100 ? 2 : (r.environment.visibilityM < 1000 ? 1 : 0)) }) %>
          <%- include('partials/metric', { label: 'Humidity', value: helpers.num(r.environment.humidityPct), unit: '%', metric: 'environment.humidityPct', dp: 1 }) %>
          <%- include('partials/metric', { label: 'Pressure', value: helpers.num(r.environment.pressureHpa), unit: 'hPa', metric: 'environment.pressureHpa', dp: 1 }) %>
          <%- include('partials/metric', { label: 'Snow depth', value: helpers.num(r.environment.snowDepthCm), unit: 'cm', metric: 'environment.snowDepthCm', dp: 1 }) %>

          <div style="margin-top:auto;padding-top:14px">
            <div class="bar-h">
              <span class="eyebrow">Temperature &middot; last 8 h</span>
              <span class="mono" style="font-size:10px;color:var(--ink3)"><%= helpers.num(lo(series.temperature)) %> / <%= helpers.num(hi(series.temperature)) %> &deg;C</span>
            </div>
            <svg viewBox="0 0 240 44" preserveAspectRatio="none" style="height:42px;width:100%" role="img" aria-label="Air temperature trend for the last eight hours">
              <polyline points="<%= sparklines.temperature %>" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
            </svg>
          </div>
        </div></section>

        <!-- ENERGY -->
        <section class="bez"><div class="core">
          <div class="flex items-center justify-between" style="margin-bottom:9px">
            <h3 class="pillar-h">Energy</h3>
            <span class="eyebrow"><%= st.generatorCapacityKw %> kW rated</span>
          </div>
          <%- include('partials/metric', { label: 'Site demand', value: helpers.num(r.energy.demandKw), unit: 'kW', metric: 'energy.demandKw', dp: 1 }) %>
          <%- include('partials/metric', { label: 'Generator load', value: helpers.num(r.energy.generatorLoadKw), unit: 'kW', metric: 'energy.generatorLoadKw', dp: 1, tone: tone(r.energy.generatorLoadKw > st.generatorCapacityKw * 0.9 ? 1 : 0) }) %>
          <%- include('partials/metric', { label: 'Solar array', value: helpers.num(r.energy.solarOutputKw), unit: 'kW', metric: 'energy.solarOutputKw', dp: 1 }) %>
          <%- include('partials/metric', { label: 'Wind turbines', value: helpers.num(r.energy.windOutputKw), unit: 'kW', metric: 'energy.windOutputKw', dp: 1 }) %>
          <%- include('partials/metric', { label: 'Diesel remaining', value: helpers.int(r.energy.dieselLitres), unit: 'L', metric: 'energy.dieselLitres', dp: 0 }) %>

          <div style="margin-top:auto;padding-top:10px">
            <%- include('partials/bar', { label: 'Diesel reserve', pct: helpers.pct(r.energy.dieselLevelPct), caption: helpers.num(r.energy.dieselLevelPct) + '%', barPath: 'energy.dieselLevelPct', barMax: 100, tone: tone(r.energy.dieselLevelPct < 15 ? 2 : (r.energy.dieselLevelPct < 30 ? 1 : 0)) }) %>
            <%- include('partials/bar', { label: 'Generator utilisation', pct: helpers.pct((r.energy.generatorLoadKw / st.generatorCapacityKw) * 100), caption: Math.round((r.energy.generatorLoadKw / st.generatorCapacityKw) * 100) + '%', barPath: 'energy.generatorLoadKw', barMax: st.generatorCapacityKw, tone: tone(r.energy.generatorLoadKw > st.generatorCapacityKw * 0.9 ? 1 : 0) }) %>
            <%- include('partials/bar', { label: 'Battery bank', pct: helpers.pct(r.energy.batterySocPct), caption: helpers.num(r.energy.batterySocPct) + '%', barPath: 'energy.batterySocPct', barMax: 100, tone: tone(r.energy.batterySocPct < 25 ? 1 : 0) }) %>
          </div>
        </div></section>

        <!-- INFRASTRUCTURE -->
        <section class="bez"><div class="core">
          <div class="flex items-center justify-between" style="margin-bottom:9px">
            <h3 class="pillar-h">Infrastructure</h3>
            <%
              const hvacLevel = r.infrastructure.hvacStatus === 'fault' ? 2 : (r.infrastructure.hvacStatus === 'strained' ? 1 : 0);
              const hvacColour = hvacLevel === 2 ? 'var(--crit)' : hvacLevel === 1 ? 'var(--warn)' : 'var(--ok)';
              const hvacBg = hvacLevel === 2 ? 'rgba(168,48,28,.12)' : hvacLevel === 1 ? 'rgba(138,101,18,.12)' : 'rgba(47,109,63,.10)';
            %>
            <span class="mono" style="font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:<%= hvacColour %>;background:<%= hvacBg %>;padding:2.5px 7px;border-radius:5px">HVAC <%= r.infrastructure.hvacStatus %></span>
          </div>
          <%- include('partials/metric', { label: 'Habitat temperature', value: helpers.num(r.infrastructure.indoorTempC), unit: '°C', metric: 'infrastructure.indoorTempC', dp: 1, tone: tone(r.infrastructure.indoorTempC < 16 ? 2 : 0) }) %>
          <%- include('partials/metric', { label: 'Water reserve', value: helpers.int(r.infrastructure.waterReserveL), unit: 'L', metric: 'infrastructure.waterReserveL', dp: 0 }) %>
          <%- include('partials/metric', { label: 'Uplink latency', value: r.infrastructure.commsStatus === 'down' ? 'NO LINK' : helpers.int(r.infrastructure.uplinkLatencyMs), unit: r.infrastructure.commsStatus === 'down' ? '' : 'ms', metric: r.infrastructure.commsStatus === 'down' ? '' : 'infrastructure.uplinkLatencyMs', dp: 0, tone: tone(r.infrastructure.commsStatus === 'down' ? 2 : (r.infrastructure.commsStatus === 'degraded' ? 1 : 0)) }) %>
          <%- include('partials/metric', { label: 'Comms link', value: r.infrastructure.commsStatus.toUpperCase(), tone: tone(r.infrastructure.commsStatus === 'down' ? 2 : (r.infrastructure.commsStatus === 'degraded' ? 1 : 0)) }) %>

          <div style="margin-top:auto;padding-top:10px">
            <%- include('partials/bar', { label: 'Water reserve', pct: helpers.pct((r.infrastructure.waterReserveL / st.waterCapacityL) * 100), caption: Math.round((r.infrastructure.waterReserveL / st.waterCapacityL) * 100) + '%', barPath: 'infrastructure.waterReserveL', barMax: st.waterCapacityL, tone: tone(r.infrastructure.waterReserveL < st.waterCapacityL * 0.15 ? 1 : 0) }) %>
            <%- include('partials/bar', { label: 'Structural integrity', pct: helpers.pct(r.infrastructure.structuralIntegrityPct), caption: helpers.num(r.infrastructure.structuralIntegrityPct) + '%', barPath: 'infrastructure.structuralIntegrityPct', barMax: 100, tone: tone(r.infrastructure.structuralIntegrityPct < 85 ? 1 : 0) }) %>
            <%- include('partials/bar', { label: 'Waste tank', pct: helpers.pct(r.infrastructure.wasteTankPct), caption: helpers.num(r.infrastructure.wasteTankPct) + '%', barPath: 'infrastructure.wasteTankPct', barMax: 100, tone: tone(r.infrastructure.wasteTankPct > 85 ? 1 : 0) }) %>
          </div>
        </div></section>

        <!-- LOGISTICS -->
        <section class="bez"><div class="core">
          <div class="flex items-center justify-between" style="margin-bottom:9px">
            <h3 class="pillar-h">Logistics</h3>
            <span class="eyebrow">Capacity <%= st.crewCapacity %></span>
          </div>
          <%- include('partials/metric', { label: 'Crew on station', value: helpers.int(r.logistics.crewOnStation), unit: 'pax', metric: 'logistics.crewOnStation', dp: 0 }) %>
          <%- include('partials/metric', { label: 'Rations remaining', value: helpers.num(r.logistics.foodDaysRemaining, 1), unit: 'days', metric: 'logistics.foodDaysRemaining', dp: 1, tone: tone(r.logistics.foodDaysRemaining < 30 ? 2 : (r.logistics.foodDaysRemaining < 60 ? 1 : 0)) }) %>
          <%- include('partials/metric', { label: 'Next resupply', value: helpers.num(r.logistics.nextResupplyDays, 1), unit: 'days', metric: 'logistics.nextResupplyDays', dp: 1, tone: tone(r.logistics.nextResupplyDays > r.logistics.foodDaysRemaining ? 2 : 0) }) %>
          <%- include('partials/metric', { label: 'Medical kits', value: helpers.int(r.logistics.medicalKits), metric: 'logistics.medicalKits', dp: 0, tone: tone(r.logistics.medicalKits < 5 ? 1 : 0) }) %>
          <%- include('partials/metric', { label: 'Cargo awaiting', value: helpers.num(r.logistics.pendingCargoTonnes), unit: 't', metric: 'logistics.pendingCargoTonnes', dp: 1 }) %>

          <div style="margin-top:auto;padding-top:10px">
            <%- include('partials/bar', { label: 'Occupancy', pct: helpers.pct((r.logistics.crewOnStation / st.crewCapacity) * 100), caption: r.logistics.crewOnStation + ' / ' + st.crewCapacity, barPath: 'logistics.crewOnStation', barMax: st.crewCapacity }) %>
            <%- include('partials/bar', { label: 'Rations endurance', pct: helpers.pct((r.logistics.foodDaysRemaining / 180) * 100), caption: Math.floor(r.logistics.foodDaysRemaining) + ' days', barPath: 'logistics.foodDaysRemaining', barMax: 180, tone: tone(r.logistics.foodDaysRemaining < 30 ? 2 : (r.logistics.foodDaysRemaining < 60 ? 1 : 0)) }) %>
            <%- include('partials/bar', { label: 'Resupply window', pct: helpers.pct((r.logistics.nextResupplyDays / 90) * 100), caption: Math.ceil(r.logistics.nextResupplyDays) + ' days out', barPath: 'logistics.nextResupplyDays', barMax: 90, tone: tone(r.logistics.nextResupplyDays > r.logistics.foodDaysRemaining ? 2 : 0) }) %>
          </div>
        </div></section>
      </div>

      <!-- Trend strip -->
      <div class="grid gap-5 md:grid-cols-2">
        <section class="bez"><div class="core" style="padding:15px 18px">
          <div class="bar-h">
            <span class="eyebrow">Sustained wind &middot; last 8 h</span>
            <span class="mono" style="font-size:10px;color:var(--ink3)"><%= helpers.num(hi(series.wind)) %> kts peak</span>
          </div>
          <svg viewBox="0 0 240 44" preserveAspectRatio="none" style="height:52px;width:100%" role="img" aria-label="Sustained wind trend for the last eight hours">
            <polyline points="<%= sparklines.wind %>" fill="none" stroke="var(--ink2)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
          </svg>
        </div></section>

        <section class="bez"><div class="core" style="padding:15px 18px">
          <div class="bar-h">
            <span class="eyebrow">Site demand &middot; last 8 h</span>
            <span class="mono" style="font-size:10px;color:var(--ink3)"><%= helpers.num(hi(series.demand)) %> kW peak</span>
          </div>
          <svg viewBox="0 0 240 44" preserveAspectRatio="none" style="height:52px;width:100%" role="img" aria-label="Site electrical demand trend for the last eight hours">
            <polyline points="<%= sparklines.demand %>" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
          </svg>
        </div></section>
      </div>
    </div>
    <% } %>
  </div>

  <footer class="mt-7 flex flex-wrap items-center justify-between gap-4 pt-5" style="border-top:1px solid var(--hair-soft)">
    <p class="sub" style="max-width:60ch;font-size:11px">
      Simulated telemetry. A physics-based twin seeded on boot and advancing live, not a connection
      to live NCPOR station feeds.
    </p>
    <div class="flex items-center gap-4">
      <span class="mono" style="font-size:10px;color:var(--ink4)">rendered <%= helpers.stamp(generatedAt) %> &middot; <%= history.length %> samples</span>
      <a class="cta" href="/api/stations/<%= st.code %>">JSON API <span class="ic" aria-hidden="true">&#8599;</span></a>
    </div>
  </footer>
</main>

<script>
  (function () {
    var CODE = <%- JSON.stringify(st.code) %>;
    var signature = <%- JSON.stringify(active.alerts.map(function (a) { return a.code; }).join('|')) %>;

    function tickClock() {
      var el = document.getElementById('utc-clock');
      if (el) el.textContent = new Date().toISOString().slice(11, 19) + ' UTC';
    }
    tickClock();
    setInterval(tickClock, 1000);

    function valueAt(source, path) {
      return path.split('.').reduce(function (acc, key) {
        return acc === null || acc === undefined ? undefined : acc[key];
      }, source);
    }

    function render(value, dp) {
      if (typeof value !== 'number') return String(value);
      return dp === 0 ? Math.round(value).toLocaleString('en-IN') : value.toFixed(dp);
    }

    async function poll() {
      try {
        var response = await fetch('/api/stations/' + CODE, { headers: { accept: 'application/json' } });
        if (!response.ok) return;
        var payload = await response.json();
        var snapshot = payload && payload.data;
        if (!snapshot || !snapshot.reading) return;

        document.querySelectorAll('[data-metric]').forEach(function (el) {
          var value = valueAt(snapshot.reading, el.dataset.metric);
          if (value === undefined || value === null) return;
          el.textContent = render(value, Number(el.dataset.dp || 1));
        });

        document.querySelectorAll('[data-bar]').forEach(function (el) {
          var value = valueAt(snapshot.reading, el.dataset.bar);
          if (typeof value !== 'number') return;
          var max = Number(el.dataset.barMax || 100) || 100;
          el.style.width = Math.max(0, Math.min(100, (value / max) * 100)) + '%';
        });

        var stamp = document.getElementById('last-contact');
        if (stamp && snapshot.recordedAt) {
          stamp.textContent = String(snapshot.recordedAt).replace('T', ' ').slice(0, 19) + ' UTC';
        }

        // Alert copy and severity tints are rendered server-side. If the alert set
        // itself changed, re-render the page rather than patching it here.
        var next = (snapshot.alerts || []).map(function (a) { return a.code; }).join('|');
        if (next !== signature) window.location.reload();
      } catch (error) {
        // A dropped poll is expected on a bad link. Keep the last good values on screen.
        console.warn('[poll]', error);
      }
    }

    setInterval(poll, 5000);
  })();
</script>
