<%
  // locals: label, pct, caption, tone, barPath, barMax
  const barTone = typeof tone !== 'undefined' && tone ? tone : 'bg-cyan-400';
  const width = Math.min(100, Math.max(0, pct));
  const path = typeof barPath !== 'undefined' ? barPath : '';
  const max = typeof barMax !== 'undefined' ? barMax : 100;
%>
<div class="pt-2">
  <div class="flex items-baseline justify-between text-[11px]">
    <span class="uppercase tracking-[0.14em] text-slate-400"><%= label %></span>
    <span class="font-mono tabular-nums text-slate-300"><%= caption %></span>
  </div>
  <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-white/[0.06]">
    <div class="h-full rounded-full <%= barTone %> transition-[width] duration-700"
         style="width: <%= width %>%"<% if (path) { %> data-bar="<%= path %>" data-bar-max="<%= max %>"<% } %>></div>
  </div>
</div>
