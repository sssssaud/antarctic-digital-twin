<%
  // locals: label, pct, caption, tone, barPath, barMax
  const barTone = typeof tone !== 'undefined' && tone ? tone : '';
  const width = Math.min(100, Math.max(0, pct));
  const path = typeof barPath !== 'undefined' ? barPath : '';
  const max = typeof barMax !== 'undefined' ? barMax : 100;
%>
<div style="padding-top:9px">
  <div class="bar-h">
    <span class="ml" style="font-size:10.5px"><%= label %></span>
    <span class="mono" style="font-size:10.5px;color:var(--ink3)"><%= caption %></span>
  </div>
  <div class="bar-t">
    <div class="bar-f <%= barTone %>" style="width: <%= width %>%"<% if (path) { %> data-bar="<%= path %>" data-bar-max="<%= max %>"<% } %>></div>
  </div>
</div>
