<%
  // locals: label, value, unit, metric (dot-path for live updates), dp, tone
  const metricTone = typeof tone !== 'undefined' && tone ? tone : '';
  const metricDp = typeof dp !== 'undefined' ? dp : 1;
  const metricPath = typeof metric !== 'undefined' ? metric : '';
  const metricUnit = typeof unit !== 'undefined' && unit ? unit : '';
%>
<div class="mrow">
  <span class="ml"><%= label %></span>
  <span class="mv <%= metricTone %>"><span<% if (metricPath) { %> data-metric="<%= metricPath %>" data-dp="<%= metricDp %>"<% } %>><%= value %></span><% if (metricUnit) { %><span class="mu"><%= metricUnit %></span><% } %></span>
</div>
